<?xml version="1.0" encoding="utf-8"?>
<com.newtube.mobile.ui.common.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_greet_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:elevation="20dp"
    android:focusable="true"
    android:visibility="gone"
    app:glassCornerRadius="0dp"
    app:glassLiquid="false"
    app:glassTint="@color/meetube_glass_tint">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mobile_greet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/greet_side_padding"
            android:paddingVertical="32dp">

        </LinearLayout>

    </ScrollView>

</com.newtube.mobile.ui.common.GlassView>
