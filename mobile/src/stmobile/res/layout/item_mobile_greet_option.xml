<?xml version="1.0" encoding="utf-8"?>
<com.newtube.mobile.ui.common.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/greet_pill_height"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:glassCornerRadius="20dp"
    app:glassOnGlass="true"
    app:glassTint="@color/meetube_greet_glass_tint">

    <TextView
        android:id="@+id/mobile_greet_option_label"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:drawablePadding="14dp"
        android:drawableTint="@color/mobile_color_on_surface"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="20dp"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="16sp"
        tools:drawableStart="@drawable/ic_mobile_settings"
        tools:text="Settings" />

</com.newtube.mobile.ui.common.GlassView>
